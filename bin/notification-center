#!/usr/bin/env bash
#
# The store behind the notification center.
#
# Stock 4.5 writes live.json/history.json arrays; Foamy and stock 4.0 use
# individual popup/history files. Copy new and changed entries into our own
# archive, retaining available images independently of the daemon's limits.
# Aggregate stock files stay read-only. Explicit Foamy dismissal/clear operations
# also remove its individual files so handled notifications cannot return.
#
# Every subcommand prints JSON, one object or one array, including failures, so
# nothing that goes wrong reaches the panel as a parse error.

set -uo pipefail

# Everything this writes is a record of what you were sent, so nothing it
# creates is readable by anyone else on the machine. Set once here rather than
# per file, because the one that gets forgotten is the one that matters.
umask 077

state_home=${XDG_STATE_HOME:-$HOME/.local/state}

# Stock Omarchy uses HOME even with a custom XDG_STATE_HOME. Foamy follows XDG.
# Resolve the configured daemon separately from our archive; installation alone
# does not mean Foamy owns notifications. Explicit source overrides still win.
foamy_enabled=0
notification_state_home=$HOME/.local/state
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
shell_config=$config_home/omarchy/shell.json
foamy_manifest=$config_home/omarchy/plugins/foamy.notifications/manifest.json
if [[ -f $shell_config && -f $foamy_manifest ]] &&
   jq -e '.id == "foamy.notifications"' "$foamy_manifest" >/dev/null 2>&1 &&
   jq -e 'any(.plugins[]?; .id == "foamy.notifications") and
     ((.disabledPlugins // []) | index("foamy.notifications") | not)' "$shell_config" >/dev/null 2>&1; then
  foamy_enabled=1
  notification_state_home=$state_home
fi
src_dir=${NC_SRC_DIR:-$notification_state_home/omarchy/notifications}
src_history=${NC_SRC_HISTORY:-$src_dir/history}
source_state_dir=$(dirname "$src_dir")

# Ours.
store=${NC_STORE:-$state_home/omarchy-notification-center}
archive="$store/archive.jsonl"
images="$store/images"
seen_file="$store/seen"
lock_file="$store/lock"
dismissed_file="$store/dismissed"
cleared_at_file="$store/cleared_at"

# How much is kept. Both are ceilings and the tighter one wins: 30 days of a
# quiet week is a shorter list than 1000 notifications, and 1000 notifications
# of a loud day is a shorter list than 30 days.
keep_days=${NC_KEEP_DAYS:-30}
max_items=${NC_MAX_ITEMS:-1000}
# Whether to keep a copy of the picture a notification points at. Off is the
# setting for anyone who would rather the archive held words only, and it means
# no copy is made rather than a copy that goes unshown.
previews=${NC_PREVIEWS:-1}
preview_policy_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

die() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
  exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is not installed"

# One writer at a time, for as long as one command takes. The bar widget runs
# once per monitor, so on a two-screen desktop there are two of these racing to
# append the same notification, and an interleaved append writes half a line.
#
# The lock is taken in a subshell rather than on this shell, because `watch`
# lives for the whole session: a descriptor held open there would lock every
# other invocation out for the rest of the day.
with_lock() {
  ( exec 9>"$lock_file"; flock 9; "$@" )
}

ensure_store() {
  mkdir -p "$store" "$images" || die "cannot create $store"
  [[ -f $archive ]] || : > "$archive"
  [[ -f $dismissed_file ]] || : > "$dismissed_file"
  # Installs that predate the umask above created these 755 and 644, which on a
  # machine with a second account hands over every notification you have had
  # for the reading. Cheap enough to reassert on every call.
  chmod 700 "$store" "$images" 2>/dev/null || true
  chmod 600 "$archive" "$dismissed_file" "$seen_file" "$cleared_at_file" 2>/dev/null || true
}

now_ms() { printf '%s' "$(($(date +%s%N) / 1000000))"; }

# ---------------------------------------------------------------- ingesting

is_dismissed() {
  local key=$1
  [[ -n $key ]] || return 1
  if [[ -s $dismissed_file ]] && grep -qxF "$key" "$dismissed_file" 2>/dev/null; then
    return 0
  fi
  if [[ -s $cleared_at_file ]]; then
    local cleared_at stamp
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at > 0 )); then
      stamp=${key%%-*}
      if [[ $stamp =~ ^[0-9]+$ ]] && (( stamp <= cleared_at )); then
        return 0
      fi
    fi
  fi
  return 1
}

# Whether this notification is already in the archive. Keys are the service's
# own file names ("1787227796695-32"): a millisecond stamp and the notification
# id, which is unique per notification and stable across the move from the
# popup directory into history. That is what makes catching the same file twice
# harmless, and it has to be, because a popup is caught once while it is on
# screen and again when it is archived.
have_key() {
  grep -qF "\"key\":\"$1\"" "$archive" 2>/dev/null
}

# An icon path worth copying: something on disk rather than a themed icon name
# ("slack", "org.mozilla.firefox"), which resolves through the icon theme at
# render time and needs nothing kept for it.
is_path() {
  case $1 in
    file:///*|/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Normalize every sender file before it reaches Qt, including app icons.
# Compressed byte limits alone do not bound native decoder allocations.
copy_image() {
  local src=$1 key=$2 slot=$3 dest mime coder
  src=${src#file://}
  [[ -f $src ]] || return 0
  dest="$images/$key-$slot.png"
  if timeout -k 1 5 head -c 5242881 -- "$src" > "$dest.tmp" 2>/dev/null &&
     (( $(stat -c%s -- "$dest.tmp" 2>/dev/null || echo 5242881) <= 5242880 )); then
    mime=$(timeout -k 1 2 file -bL --mime-type -- "$dest.tmp" 2>/dev/null) || mime=""
    case $mime in
      image/png) coder=PNG ;;
      image/jpeg) coder=JPEG ;;
      image/gif) coder=GIF ;;
      image/webp) coder=WEBP ;;
      image/bmp|image/x-ms-bmp) coder=BMP ;;
      image/vnd.microsoft.icon|image/x-icon) coder=ICO ;;
      image/svg+xml) coder=""; [[ $slot != preview ]] && coder=RSVG ;;
      *) coder="" ;;
    esac
    if [[ -n $coder ]] && resize_preview "$coder" "$dest.tmp" "$dest.resized" &&
       mv -f -- "$dest.resized" "$dest"; then
      rm -f -- "$dest.tmp"
      printf 'file://%s' "$dest"
      return 0
    fi
  fi
  printf 'notification-center: %s_rejected: unsupported image, decoder unavailable, or conversion limit reached; keeping notification text\n' "$slot" >&2
  rm -f -- "$dest.tmp" "$dest.resized"
}

# Only theme names bypass file normalization. Sender-chosen provider URLs must
# not ask the shell to decode a file through another image provider.
archive_image() {
  local src=$1 key=$2 slot=$3
  if is_path "$src"; then
    copy_image "$src" "$key" "$slot"
  elif [[ $slot == appIcon && $src =~ ^[[:alnum:]_.-]+$ ]]; then
    printf '%s' "$src"
  fi
  return 0
}

resize_preview() (
  local coder=$1 src=$2 dest=$3 scratch
  command -v magick >/dev/null 2>&1 || return 1
  [[ -r $preview_policy_dir/policy.xml ]] || return 1
  # OS limits also cover decoder allocations outside ImageMagick's pixel cache.
  # The external deadline kills stuck decoders while the archive lock is held.
  ulimit -c 0 -v 524288 -f 10240 || return 1
  if [[ $coder == RSVG ]]; then
    # Librsvg confines linked resources to the base directory. Read stdin in
    # an empty directory so a sender's SVG cannot load neighbouring files.
    scratch=$(mktemp -d) || return 1
    trap 'rmdir -- "$scratch"' EXIT
    ( cd "$scratch" && MAGICK_CONFIGURE_PATH="$preview_policy_dir" timeout -k 1 5 \
      magick -background none 'RSVG:-[0]' -auto-orient -resize '720x720>' -strip "PNG:$dest" < "$src" 2>/dev/null ) || return 1
  else
    MAGICK_CONFIGURE_PATH="$preview_policy_dir" timeout -k 1 5 \
      magick "$coder:${src}[0]" -auto-orient -resize '720x720>' -strip \
      "PNG:$dest" 2>/dev/null || return 1
  fi
  [[ -s $dest ]] && (( $(stat -c%s -- "$dest" 2>/dev/null || echo 5242881) <= 5242880 ))
)

# The picture a notification is about, as opposed to the icon of whatever sent
# it. Apps that photograph something (a camera catching movement, a screenshot
# tool) tend not to set an image hint at all: they hand the file to the action
# instead, so clicking the toast opens it. That path is the only place the
# picture is named, so this is where a motion alert gets its thumbnail.
#
# This is also the allowlist for what a click on an archived notification is
# allowed to open, and the reason it is this narrow. The action a notification
# arrives with is chosen by whoever sent the notification, and anything on the
# machine can send one. Keeping that action and running it later is handing an
# attacker a command that fires whenever somebody clicks a row, so it is never
# kept. What is kept is at most an absolute path to an image, taken out of the
# action and opened by argument rather than by shell.
#
# Two shapes arrive here. Omarchy now sends the action as `omarchy-exec-argv`,
# a JSON vector whose elements are already discrete arguments, so a candidate
# is one whole element and a space in a filename is just a space. Older toasts,
# and anything still in the archive from before, carry `omarchy-exec`: one
# shell string, where a space is a separator and a path containing one cannot
# be told apart from two arguments. That is why the string branch refuses
# spaces and the vector branch does not.
#
# Either way: absolute, no quotes, no newlines, and an image extension. A path
# that survives this cannot become an option, a second command, or a .desktop
# file that runs on open.
preview_source() {
  local action=$1

  if [[ $action == \[* ]]; then
    printf '%s' "$action" | jq -r --arg re '^(file://)?/[^"'"'"'\r\n]*\.(jpe?g|png|webp|gif)$' '
      if type == "array" then
        .[] | select(type == "string") | select(test($re; "i"))
      else empty end
    ' 2>/dev/null | head -n 1
    return
  fi

  printf '%s' "$action" | grep -oiE "(file://)?/[^\"' ]*\.(jpe?g|png|webp|gif)" | head -n 1
}

# Reduce the standard screenshot argv to a fixed intent, with no executable
# or extra arguments retained. Other editors remain live-only actions.
screenshot_action() {
  local action=$1 file=$2
  printf '%s' "$action" | jq -r --arg file "$file" '
    if type == "array" and length == 2 then
      if (.[0] == "tensaku-edit" or .[0] == "/usr/bin/tensaku-edit"
          or .[0] == "omasnap" or .[0] == "/usr/bin/omasnap")
         and (.[1] | type == "string") and (.[1] | sub("^file://"; "")) == $file and $file != ""
      then "edit-screenshot" else "" end
    else "" end
  ' 2>/dev/null || true
}

# Archive new or changed source content. One shared service receives these
# updates; unchanged filesystem events must not repeat unread or retention work.
ingest_file() {
  local LC_ALL=C
  local file=$1
  local key source_json
  key=$(basename -- "$file"); key=${key%.json}
  if [[ $key == live || $key == history ]]; then
    (( foamy_enabled )) && return 0
    ingest_array "$file"
    return $?
  fi
  [[ $key =~ ^[0-9]+-[0-9]+$ ]] || return 0
  [[ -s $file ]] || return 0
  source_json=$(head -c 131073 -- "$file") || return 1
  (( ${#source_json} <= 131072 )) || return 0
  ingest_json "$key" "$source_json"
}

# Stock 4.5 writes bounded arrays atomically; keep its opaque identity separate
# from Foamy/4.0 timestamp-id keys. Never rewrite the daemon's aggregate files.
ingest_array() {
  local file=$1 rows row key
  [[ -s $file ]] || return 0
  rows=$(python3 "$preview_policy_dir/read-stock-notifications.py" "$file" "$archive") || return 1
  while IFS= read -r row; do
    [[ -n $row ]] || continue
    (( ${#row} <= 131072 )) || continue
    key=$(jq -r .key <<< "$row") || return 1
    ingest_json "$key" "$row" || return 1
  done <<< "$rows"
}

valid_key() { [[ $1 =~ ^([0-9]+-[0-9]+|stock-[A-Za-z0-9_-]{1,120})$ ]]; }

ingest_json() {
  local key=$1 source_json=$2
  local entry app_icon image_src exec_src icon_copy image_copy file_src file_action preview_copy existing source_hash assets_hash sources_hash asset
  is_dismissed "$key" && return 0
  # A file caught mid-write parses as nothing; it will be caught again on the
  # move into history, or by the next sync.
  jq -e . <<< "$source_json" >/dev/null 2>&1 || return 0

  # Transient action feedback remains a toast and does not enter this archive.
  jq -e '.transient == true' <<< "$source_json" >/dev/null 2>&1 && return 0

  if [[ -s $cleared_at_file ]]; then
    local cleared_at file_stamp
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at > 0 )); then
      file_stamp=$(jq -r '(.timestamp // 0) | tonumber?' <<< "$source_json" 2>/dev/null || echo 0)
      if [[ $file_stamp =~ ^[0-9]+$ ]] && (( file_stamp > 0 && file_stamp <= cleared_at )); then
        return 0
      fi
    fi
  fi

  app_icon=$(jq -r '.appIcon // ""' <<< "$source_json")
  image_src=$(jq -r '.image // ""' <<< "$source_json")
  # execArgv is what the service writes now; exec is what it wrote before.
  exec_src=$(jq -r '.execArgv // .exec // ""' <<< "$source_json")

  file_src=$(preview_source "$exec_src")
  file_src=${file_src#file://}
  file_action=$(screenshot_action "$exec_src" "$file_src")
  existing=$(grep -F "\"key\":\"$key\"" "$archive" | head -n 1)
  # An in-place stock update changes ts; keep the first arrival for unread state.
  if [[ $key == stock-* && -n $existing ]]; then
    source_json=$(jq --argjson stamp "$(jq '.timestamp' <<< "$existing")" '.timestamp = $stamp' <<< "$source_json") || return 1
  fi
  source_hash=$(printf '%s' "$source_json" | sha256sum); source_hash=${source_hash%% *}
  sources_hash=$(printf '%s\n' "$app_icon" "$image_src" "$file_src" "$previews" | sha256sum); sources_hash=${sources_hash%% *}
  # Reuse retained images on text-only updates, but invalidate when source files change.
  assets_hash=$({
    printf '%s\n' "$app_icon" "$image_src" "$file_src" "$previews"
    for asset in "$app_icon" "$image_src" "$file_src"; do
      is_path "$asset" && stat -Lc '%d:%i:%s:%y:%z' -- "${asset#file://}" 2>/dev/null
    done
  } | sha256sum); assets_hash=${assets_hash%% *}
  if [[ -n $existing ]] && [[ $(jq -r '.fileAction // ""' <<< "$existing") == "$file_action" ]] && [[ $(jq -r '.imageFormat // 0' <<< "$existing") == 1 ]] && [[ $(jq -r '.sourceHash // ""' <<< "$existing") == "$source_hash" ]] &&
     [[ $(jq -r '.assetsHash // ""' <<< "$existing") == "$assets_hash" ]]; then
    return 0
  fi
  if [[ -n $existing ]] && [[ $(jq -r '.imageFormat // 0' <<< "$existing") == 1 ]] && [[ $(jq -r '.assetsHash // ""' <<< "$existing") == "$assets_hash" ]]; then
    icon_copy=$(jq -r '.appIcon // ""' <<< "$existing")
    image_copy=$(jq -r '.image // ""' <<< "$existing")
    preview_copy=$(jq -r '.preview // ""' <<< "$existing")
  else
    icon_copy=$(archive_image "$app_icon" "$key" "appIcon")
    image_copy=$(archive_image "$image_src" "$key" "image")
    preview_copy=""
    if (( previews )) && [[ -n $file_src ]]; then
      preview_copy=$(copy_image "$file_src" "$key" "preview")
    fi
    # Sender cleanup is not an image change: keep retained copies when the same original disappears.
    if [[ -n $existing ]] && [[ $(jq -r '.imageFormat // 0' <<< "$existing") == 1 ]] && [[ $(jq -r '.assetSources // ""' <<< "$existing") == "$sources_hash" ]]; then
      if is_path "$app_icon" && [[ ! -e ${app_icon#file://} ]]; then icon_copy=$(jq -r '.appIcon // ""' <<< "$existing"); fi
      if is_path "$image_src" && [[ ! -e ${image_src#file://} ]]; then image_copy=$(jq -r '.image // ""' <<< "$existing"); fi
      if [[ -n $file_src && ! -e $file_src ]]; then preview_copy=$(jq -r '.preview // ""' <<< "$existing"); fi
    fi
  fi

  entry=$(jq -c \
    --arg key "$key" \
    --arg sourceHash "$source_hash" \
    --arg assetsHash "$assets_hash" \
    --arg assetSources "$sources_hash" \
    --arg appIcon "$icon_copy" \
    --arg image "$image_copy" \
    --arg preview "$preview_copy" \
    --arg file "$file_src" \
    --arg fileAction "$file_action" \
    '{
       key: $key,
       imageFormat: 1,
       sourceHash: $sourceHash,
       stockHash: (.stockHash // ""),
       assetsHash: $assetsHash,
       assetSources: $assetSources,
       desktopEntry: (.desktopEntry // ""),
       app: (.app // ""),
       appIcon: $appIcon,
       summary: (.summary // ""),
       body: (.body // ""),
       image: $image,
       preview: $preview,
       file: $file,
       fileAction: $fileAction,
       glyph: (.glyph // ""),
       urgency: (.urgency // 1),
       timestamp: (.timestamp // 0)
     }
     | .timestamp = (if .timestamp > 0 then .timestamp
                     else ((.key | split("-")[0] | tonumber?) // 0) end)' \
    <<< "$source_json" 2>/dev/null) || return 0
  [[ -n $entry ]] || return 0

  if [[ -n $existing ]]; then
    # Replace in place: a progress update is the same unread notification, not a new arrival.
    # Notification text stays in a private file, never in process arguments.
    printf '%s\n' "$entry" > "$archive.entry" || return 1
    jq -Rc --arg key "$key" --slurpfile replacement "$archive.entry" 'fromjson? | if .key == $key then $replacement[0] else . end' "$archive" > "$archive.tmp"
    local result=$?
    rm -f -- "$archive.entry"
    (( result == 0 )) || return 1
    mv -f "$archive.tmp" "$archive" || return 1
  else
    printf '%s\n' "$entry" >> "$archive"
  fi
  ingest_changed=1
  printf '%s\n' "$entry"
}

# Everything the service is holding, oldest first so the archive stays in the
# order things happened. Live popups are read before history: a notification
# that is on screen right now belongs in the center immediately, not when it
# expires.
sync_all() {
  local file
  for file in "$src_history"/*.json "$src_dir"/*.json; do
    [[ -e $file ]] || continue
    ingest_file "$file" || return 1
  done
}

# ---------------------------------------------------------------- trimming

# Drop what is past either ceiling, and take the images of dropped entries with
# them. Runs after an ingest rather than on a timer: the only thing that can
# push the archive over a limit is something being added to it.
prune() {
  local cutoff kept dropped
  cutoff=$(( $(now_ms) - keep_days * 86400000 ))

  if [[ -s $cleared_at_file ]]; then
    local cleared_at
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at < cutoff )); then
      rm -f -- "$cleared_at_file"
    fi
  fi

  if [[ -s $dismissed_file ]]; then
    tail -n 2000 "$dismissed_file" > "$dismissed_file.tmp" 2>/dev/null && mv -f "$dismissed_file.tmp" "$dismissed_file"
  fi

  [[ -s $archive ]] || return 0

  # Read first, and only then decide to write. A single unparseable line makes
  # jq exit non-zero having printed nothing, and this used to run that nothing
  # straight back over the archive: one bad byte and somebody's month of
  # notifications was gone. The pipeline hid it twice over, because the status
  # of `jq | tail` is tail's and tail is always happy, and because the `||` on
  # the write emptied the file on the other branch as well. So no pipeline
  # here, and a failed read leaves the archive exactly as it was.
  #
  # An empty result from a jq that *succeeded* is a real answer: everything in
  # there has aged out, and the archive is meant to end up empty.
  # `fromjson?` rather than a plain read: one unparseable line is skipped and
  # the rest of the file still gets through. A plain `jq` stops dead at that
  # line, which meant everything after it was missing from `kept` and was then
  # written back over the archive as the new truth. Everything below the bad
  # byte, gone.
  if ! kept=$(jq -Rc --argjson cutoff "$cutoff" \
      'fromjson? // empty | select(.timestamp >= $cutoff)' "$archive" 2>/dev/null); then
    return 0
  fi
  kept=$(printf '%s\n' "$kept" | tail -n "$max_items")

  dropped=$(comm -23 \
    <(jq -r '.key' "$archive" 2>/dev/null | sort) \
    <(printf '%s\n' "$kept" | jq -r 'select(.key) | .key' 2>/dev/null | sort))

  printf '%s\n' "$kept" | grep -v '^$' > "$archive.tmp" || true
  mv -f "$archive.tmp" "$archive"

  local key
  while IFS= read -r key; do
    [[ -n $key ]] || continue
    rm -f -- "$images/$key-appIcon" "$images/$key-image" "$images/$key-preview" \
      "$images/$key-appIcon.png" "$images/$key-image.png" "$images/$key-preview.png"
    # The source file too. It was the service's copy of something this archive
    # now no longer has, so there is nothing left that would show it again.
    rm -f -- "$src_history/$key.json"
  done <<< "$dropped"

  # And the source files under the clear line. Clear draws that line instead of
  # deleting anything, which leaves the tidying to happen here: the archive has
  # these, nothing is going to show them again, and this directory is not
  # cleaned by anybody else. Doing it on the retention pass rather than on the
  # click is the whole point, because a click that deletes is a click you have
  # to be sure about.
  if [[ -s $cleared_at_file ]]; then
    local cleared_at f base stamp
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at > 0 )); then
      for f in "$src_history"/*.json; do
        [[ -e $f ]] || continue
        base=${f##*/}
        base=${base%.json}
        stamp=${base%%-*}
        [[ $stamp =~ ^[0-9]+$ ]] || continue
        (( stamp <= cleared_at )) && rm -f -- "$f"
      done
    fi
  fi
  return 0
}

# ---------------------------------------------------------------- commands

# `sync` on the command line reports one line, like everything else here; the
# entries it took in are only interesting to `watch`, which streams them to the
# panel. quiet=1 is what keeps a plain sync from printing a page of JSON.
quiet=0

sync_and_prune() {
  if (( quiet )); then
    sync_all >/dev/null || return 1
  else
    sync_all || return 1
  fi
  prune
}

cmd_sync() {
  ensure_store
  with_lock prepare_archive || die "cannot normalize notification archive"
  with_lock sync_and_prune || die "cannot synchronize notification history"
}

# An archive written before stored actions were removed still holds them. That
# is a command an attacker picked, sitting in a file, waiting for a click, so
# it is not something to leave until somebody thinks to run a migration: every
# sync clears it, and once cleared the grep costs nothing.
disarm_archive() {
  grep -qE '"(exec|execArgv)"[[:space:]]*:' "$archive" 2>/dev/null || return 0
  backfill_previews >/dev/null
}

prepare_archive() {
  disarm_archive || return 1
  normalize_archive
}

# Older records may outlive their sender files. Convert their retained copies
# under the archive lock before any list is returned, including the first load
# racing watcher startup. New URLs avoid Qt reusing a cached original JPEG.
normalize_archive() {
  local pending line key icon image preview
  pending=$(jq -Rc 'fromjson? | select(.imageFormat != 1) |
    select(any(.appIcon, .image, .preview; type == "string" and (contains("/") or contains(":"))))' "$archive") || return 1
  [[ -n $pending ]] || return 0
  : > "$archive.images" || return 1
  while IFS= read -r line; do
    key=$(jq -r '.key // ""' <<< "$line") || return 1
    icon=""; image=""; preview=""
    if valid_key "$key"; then
      icon=$(archive_image "$(jq -r '.appIcon // ""' <<< "$line")" "$key" appIcon)
      image=$(archive_image "$(jq -r '.image // ""' <<< "$line")" "$key" image)
      preview=$(archive_image "$(jq -r '.preview // ""' <<< "$line")" "$key" preview)
    fi
    jq -c --arg icon "$icon" --arg image "$image" --arg preview "$preview" \
      '. + {appIcon:$icon, image:$image, preview:$preview, imageFormat:1}' <<< "$line" >> "$archive.images" || return 1
  done <<< "$pending"
  jq -Rc --slurpfile replacements "$archive.images" '
    ($replacements | INDEX(.key)) as $updates | fromjson? | $updates[.key] // .
  ' "$archive" > "$archive.tmp" || return 1
  mv -f -- "$archive.tmp" "$archive" || return 1
  rm -f -- "$archive.images"
  while IFS= read -r key; do
    valid_key "$key" || continue
    rm -f -- "$images/$key-appIcon" "$images/$key-image" "$images/$key-preview"
  done < <(jq -r '.key' <<< "$pending")
}

cmd_watch() {
  ensure_store
  mkdir -p "$src_dir"
  local watch_paths=("$src_dir" "$source_state_dir" "$store")
  if (( foamy_enabled )) || [[ ! -e $src_dir/live.json && ! -e $src_dir/history.json ]]; then mkdir -p "$src_history"; fi
  [[ ! -d $src_history ]] || watch_paths+=("$src_history")
  command -v inotifywait >/dev/null 2>&1 || die "inotifywait is not installed"
  # Include the state directory so even the first DND file creation is observed.
  # Establish watches before startup reconciliation so arrivals cannot fall into a gap.
  exec 3< <(LC_ALL=C inotifywait -m -e close_write -e moved_to -e delete -e create -e delete_self -e move_self --format '%e|%w%f' \
    "${watch_paths[@]}" 2>&1)
  watcher=$!
  trap 'kill "$watcher" 2>/dev/null || true' EXIT INT TERM
  local event file ready=0
  while IFS= read -r event <&3; do
    if [[ $event == 'Watches established.' ]]; then ready=1; break; fi
  done
  (( ready )) || die "notification watcher failed to start"
  cmd_sync
  printf '%s\n' '{"event":"storeChanged"}'
  while IFS='|' read -r event file <&3; do
    if [[ $event == *DELETE_SELF* || $event == *MOVE_SELF* ]]; then
      die "notification source changed; reconnecting"
    elif [[ $event == *Q_OVERFLOW* ]]; then
      cmd_sync
      printf '%s\n' '{"event":"storeChanged"}'
    elif [[ $file == "$store/archive.jsonl" || $file == "$cleared_at_file" || $file == "$dismissed_file" ]]; then
      printf '%s\n' '{"event":"storeChanged"}'
    elif [[ $file == "$source_state_dir/notifications.json" || $file == "$src_dir/quiet.json" ]]; then
      printf '%s\n' '{"event":"dndChanged"}'
    elif [[ $event == CREATE* ]]; then
      # Ordinary JSON writes are ingested only when complete; Qt links its DND file atomically.
      continue
    elif [[ $file == "$seen_file" ]]; then
      printf '%s\n' '{"event":"seenChanged"}'
    elif [[ $file == "$src_dir/"*.json || $file == "$src_history/"*.json ]]; then
      [[ $event == *DELETE* ]] || with_lock ingest_one "$file" || die "cannot update notification archive"
    fi
  done
  die "notification watcher stopped"
}

ingest_one() {
  ingest_changed=0
  ingest_file "$1" || return $?
  # Duplicate filesystem events and archival moves do not need a retention rewrite.
  (( ingest_changed )) && prune
  return 0
}

cmd_list() {
  ensure_store
  with_lock normalize_archive || die "cannot normalize notification archive"
  local limit=${1:-200}
  local cleared_at=0
  if [[ -s $cleared_at_file ]]; then
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    [[ $cleared_at =~ ^[0-9]+$ ]] || cleared_at=0
  fi

  # Newest first, because that is the order it is read in. Cleared entries are
  # filtered rather than deleted, so the cut has to happen before the limit:
  # take the newest N of what is still showing, not what is left of the newest
  # N after the cleared ones are dropped out of it.
  [[ $limit =~ ^[0-9]+$ ]] || die "list limit must be a nonnegative integer"
  local result
  # Consume the whole stream but retain only the requested page. Closing a pipe
  # early with head causes SIGPIPE and can append a second JSON value under pipefail.
  result=$(tac "$archive" | jq -Rnc --argjson cleared "$cleared_at" --argjson limit "$limit" '
    reduce (inputs | fromjson? | select((.timestamp // 0) > $cleared)) as $row
      ([]; if length < $limit then . + [$row] else . end)
  ') || die "cannot read notification archive"
  printf '%s\n' "$result"
}

cmd_remove() {
  ensure_store
  (( $# > 0 )) || die "remove needs a key"
  local key
  for key in "$@"; do
    valid_key "$key" || die "invalid notification key"
  done
  with_lock remove_keys "$@" || die "could not remove notifications"
  printf '{"ok":true,"removed":%s,"count":%s}\n' "$(printf '%s' "$1" | jq -Rs .)" "$#"
}

remove_keys() {
  local key
  # One locked rewrite avoids spawning a process and scanning the archive per card.
  jq -Rc --args '($ARGS.positional | INDEX(.)) as $keys | fromjson? | select($keys[.key] == null)' \
    -- "$@" < "$archive" > "$archive.tmp" || return 1
  printf '%s\n' "$@" >> "$dismissed_file" || return 1
  mv -f "$archive.tmp" "$archive" || return 1
  for key in "$@"; do
    rm -f -- "$images/$key-appIcon" "$images/$key-image" "$images/$key-preview" \
      "$images/$key-appIcon.png" "$images/$key-image.png" "$images/$key-preview.png" \
      "$src_history/$key.json" "$src_dir/$key.json" || return 1
  done
}

# Clear is a line drawn under what you have seen, not a shredder. It used to
# empty the archive, delete every stored image, and delete the source history
# out from under the service as well, which is a lot of somebody's month to
# hang on one click with no way back.
#
# The timestamp on its own already does the whole job: `is_dismissed` treats
# every key older than it as dismissed, ingest skips source files older than
# it, and `list` filters on it. Everything below the line simply stops being
# shown, and ages out through the ordinary retention limits like everything
# else. Nothing to confirm, because nothing is destroyed.
clear_all() {
  now_ms > "$cleared_at_file"
}

cmd_clear() {
  ensure_store
  with_lock clear_all
  printf '{"ok":true,"cleared":true}\n'
}

# When the center was last opened. Everything newer than this is what the bar
# marks as unread, and it is a file rather than shell state because "unread"
# has to survive a shell restart to mean anything.
cmd_seen() {
  ensure_store
  if [[ $# -gt 0 && -n ${1:-} ]]; then
    printf '%s\n' "$1" > "$seen_file"
    printf '{"ok":true,"seen":%s}\n' "$1"
    return
  fi
  printf '{"ok":true,"seen":%s}\n' "$(cat "$seen_file" 2>/dev/null || echo 0)"
}

cmd_unread() {
  ensure_store
  local seen
  seen=$(cat "$seen_file" 2>/dev/null || echo 0)
  printf '{"ok":true,"unread":%s}\n' \
    "$(jq -s --argjson seen "${seen:-0}" '[.[] | select(.timestamp > $seen)] | length' "$archive" 2>/dev/null || echo 0)"
}

# Fills the archive with plausible-looking traffic, for working on the panel
# without waiting for a week of real notifications to arrive, and for taking a
# screenshot that gives nobody's messages away.
#
# The entries are spread back over three days so the day headings have
# something to head, and they name real apps with real icon names so the icons
# resolve out of the icon theme the way they do for the real thing.
cmd_seed() {
  ensure_store
  rm -f -- "$cleared_at_file"
  : > "$dismissed_file"
  with_lock seed_entries "${1:-25}"
  printf '{"ok":true,"seeded":%s}\n' "${1:-25}"
}

# Generic demo data: app | icon | summary | body | minutes ago
readonly SEED_ROWS=(
  "Files|org.gnome.Nautilus|Transfer complete|All files were copied successfully.|2"
  "Files|org.gnome.Nautilus|Download complete|The archive is ready to open.|8"
  "Files|org.gnome.Nautilus|Folder synchronized|Everything is up to date.|15"
  "System|org.gnome.Software|Update available|New system updates are ready.|5"
  "System|org.gnome.Software|Updates installed|Your system is up to date.|25"
  "Calendar|org.gnome.Calendar|Team meeting|Starts in 30 minutes.|35"
)

seed_entries() {
  local count=${1:-25} i row stamp key
  local app icon summary body minutes
  local total=${#SEED_ROWS[@]}
  for (( i = 0; i < count; i++ )); do
    row=${SEED_ROWS[$((i % total))]}
    IFS='|' read -r app icon summary body minutes <<< "$row"
    # Past one lap through the list the same entries come round again, pushed
    # another two days back so they land on their own day rather than on top of
    # the ones they are copies of.
    stamp=$(( $(now_ms) - (minutes + (i / total) * 2880) * 60000 ))
    key="$stamp-$((1000000000 + i))"
    jq -cn \
      --arg key "$key" \
      --arg app "$app" \
      --arg appIcon "$icon" \
      --arg summary "$summary" \
      --arg body "$body" \
      --arg preview "" \
      --argjson timestamp "$stamp" \
      '{key:$key, app:$app, appIcon:$appIcon, summary:$summary, body:$body,
        image:"", preview:$preview, file:"", glyph:"", urgency:1,
        timestamp:$timestamp}' >> "$archive"
  done
  # Seeded entries land out of order; the archive is read newest-first off the
  # tail, so it has to be sorted or half of them never show up.
  jq -sc 'sort_by(.timestamp) | .[]' "$archive" > "$archive.tmp" && mv -f "$archive.tmp" "$archive"
}

# Two jobs over the existing archive, both idempotent, both safe to run twice.
#
# The first is the important one: an archive written by an older version still
# holds `exec` or `execArgv`, the sender-chosen command it arrived with.
# Strip both after extracting only an image path, without evaluating commands.
#
# The second is the ordinary one: entries that never had a picture get one now
# if the file they name is still on disk.
backfill_previews() {
  local tmp="$archive.backfill" line key exec_src file_src file_action preview_copy filled=0
  : > "$tmp"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    key=$(printf '%s' "$line" | jq -r '.key // ""')
    [[ -n $key ]] || { printf '%s' "$line" | jq -c 'del(.exec, .execArgv)' >> "$tmp"; continue; }

    file_src=$(printf '%s' "$line" | jq -r '.file // ""')
    # Existing file fields must pass the same whole-path allowlist as new ones.
    file_src=$(preview_source "$(jq -cn --arg file "$file_src" '[$file]')")
    if [[ -z $file_src ]]; then
      exec_src=$(printf '%s' "$line" | jq -r '.execArgv // .exec // ""')
      file_src=$(preview_source "$exec_src")
    fi
    file_src=${file_src#file://}

    file_action=$(printf '%s' "$line" | jq -r '.fileAction // ""')
    if [[ $file_action != edit-screenshot ]]; then
      file_action=$(screenshot_action "$(printf '%s' "$line" | jq -r '.execArgv // ""')" "$file_src")
    fi
    [[ -n $file_src ]] || file_action=""
    preview_copy=$(printf '%s' "$line" | jq -r '.preview // ""')
    if [[ -z $preview_copy && -n $file_src ]] && (( previews )); then
      preview_copy=$(copy_image "$file_src" "$key" "preview")
      [[ -n $preview_copy ]] && filled=$(( filled + 1 ))
    fi

    printf '%s' "$line" | jq -c \
      --arg file "$file_src" \
      --arg preview "$preview_copy" \
      --arg fileAction "$file_action" \
      'del(.exec, .execArgv) + {file: $file, fileAction: $fileAction, preview: $preview}' >> "$tmp"
  done < "$archive"
  mv -f "$tmp" "$archive"
  printf '%s' "$filled"
}

case ${1:-} in
  sync)   shift; quiet=1; cmd_sync; printf '{"ok":true,"synced":true}\n' ;;
  watch)  shift; cmd_watch ;;
  list)   shift; cmd_list "${1:-200}" ;;
  remove) shift; cmd_remove "$@" ;;
  clear)  shift; cmd_clear ;;
  seen)   shift; cmd_seen "$@" ;;
  unread) shift; cmd_unread ;;
  seed)   shift; cmd_seed "${1:-25}" ;;
  backfill)
    shift; ensure_store
    printf '{"ok":true,"filled":%s}\n' "$(with_lock backfill_previews)"
    ;;
  prune)  shift; ensure_store; with_lock prune; printf '{"ok":true,"pruned":true}\n' ;;
  *)
    cat >&2 <<'USAGE'
notification-center: the store behind the Omarchy notification center

  watch              follow the notification service and archive what it receives
  sync               catch up on anything not archived yet
  list [LIMIT]       the archive as JSON, newest first (default 200)
  remove KEY...      drop the specified notifications
  clear              drop all of them
  seen [MS]          read or set when the center was last opened
  unread             how many arrived since then
  seed [N]           fill the archive with test traffic
  backfill           give older entries the picture their action points at
  prune              apply the retention limits now
USAGE
    exit 64
    ;;
esac
